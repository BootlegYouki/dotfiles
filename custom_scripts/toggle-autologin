#!/usr/bin/env bash
# toggle-autologin: Manage SDDM autologin for unattended remote access

AUTOLOGIN_FILE="/etc/sddm.conf.d/autologin.conf"

status() {
    if [ -f "$AUTOLOGIN_FILE" ] && grep -q "User=youki" "$AUTOLOGIN_FILE"; then
        return 0
    else
        return 1
    fi
}

enable() {
    sudo bash -c 'cat <<EOF > /etc/sddm.conf.d/autologin.conf
[Autologin]
User=youki
Session=hyprland-uwsm
EOF'
    notify-send -a "Caelestia" -i "system-lock-screen" "Auto-Login Enabled" "PC will boot directly to desktop for remote access" -u normal 2>/dev/null || true
}

disable() {
    if [ -f "$AUTOLOGIN_FILE" ]; then
        sudo rm -f "$AUTOLOGIN_FILE"
    fi
    notify-send -a "Caelestia" -i "system-lock-screen" "Auto-Login Disabled" "Password will be required on boot" -u normal 2>/dev/null || true
}

case "$1" in
    status)
        if status; then
            echo "enabled"
            exit 0
        else
            echo "disabled"
            exit 1
        fi
        ;;
    on|enable)
        enable
        ;;
    off|disable)
        disable
        ;;
    toggle)
        if status; then
            disable
        else
            enable
        fi
        ;;
    *)
        echo "Usage: $0 {status|on|off|toggle}"
        exit 1
        ;;
esac
