{
    "toggles": {
        "communication": {
            "discord": {
                "enable": true,
                "match": [
                    { "class": "discord" },
                    { "class": "com.discordapp.Discord" },
                    { "class": "Discord" }
                ],
                "command": [
                    "uwsm",
                    "app",
                    "--",
                    "discord"
                ],
                "move": true
            }
        }
    },
    "wallpaper": {
        "postHook": "sudo /usr/share/sddm/themes/caelestia/scripts/sync.sh --posthook"
    },
    "theme": {
        "postHook": "sudo /usr/share/sddm/themes/caelestia/scripts/sync.sh --posthook"
    }
}
