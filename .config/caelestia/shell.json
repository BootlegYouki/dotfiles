{
    "appearance": {
        "rounding": {
            "scale": 1
        },
        "transparency": {
            "enabled": true
        }
    },
    "background": {
        "desktopClock": {
            "enabled": true,
            "position": "bottom-right"
        },
        "wallpaperEnabled": true
    },
    "bar": {
        "clock": {
            "showDate": true
        },
        "excludedScreens": [
            "DP-1"
        ],
        "persistent": true,
        "tray": {
            "compact": true
        },
        "workspaces": {
            "specialWorkspaceIcons": [
                {
                    "icon": "terminal",
                    "name": "dev"
                }
            ],
            "windowIcons": [
                {
                    "icon": "diamond",
                    "regex": "obsidian|Obsidian|md.obsidian.Obsidian"
                },
                {
                    "icon": "sports_esports",
                    "regex": "Twintaillauncher|twintaillauncher|app.twintaillauncher.ttl"
                }
            ]
        }
    },
    "general": {
        "apps": {
            "playback": [
                "vlc",
                "--started-from-file"
            ]
        },
        "idle": {
            "inhibitWhenAudio": true,
            "inhibitWhenCharging": false,
            "lockBeforeSleep": true,
            "timeouts": [
                {
                    "idleAction": "lock",
                    "respectInhibitors": true,
                    "timeout": 300
                },
                {
                    "idleAction": "dpms off",
                    "respectInhibitors": true,
                    "returnAction": "dpms on",
                    "timeout": 600
                }
            ]
        },
        "logo": "caelestia"
    },
    "launcher": {
        "actions": [
            {
                "command": [
                    "autocomplete",
                    "calc"
                ],
                "dangerous": false,
                "description": "Do simple math equations (powered by Qalc)",
                "enabled": true,
                "icon": "calculate",
                "name": "Calculator"
            },
            {
                "command": [
                    "autocomplete",
                    "wallpaper"
                ],
                "dangerous": false,
                "description": "Select or change desktop wallpaper",
                "enabled": true,
                "icon": "wallpaper",
                "name": "Wallpapers"
            },
            {
                "command": [
                    "autocomplete",
                    "scheme"
                ],
                "dangerous": false,
                "description": "Change the Material 3 colour scheme",
                "enabled": true,
                "icon": "palette",
                "name": "Scheme"
            },
            {
                "command": [
                    "autocomplete",
                    "variant"
                ],
                "dangerous": false,
                "description": "Change the Material 3 colour variant",
                "enabled": true,
                "icon": "format_paint",
                "name": "Variant"
            },
            {
                "command": [
                    "setMode",
                    "dark"
                ],
                "dangerous": false,
                "description": "Switch UI theme to dark mode",
                "enabled": true,
                "icon": "dark_mode",
                "name": "Dark Mode"
            },
            {
                "command": [
                    "setMode",
                    "light"
                ],
                "dangerous": false,
                "description": "Switch UI theme to light mode",
                "enabled": true,
                "icon": "light_mode",
                "name": "Light Mode"
            },
            {
                "command": [
                    "loginctl",
                    "lock-session"
                ],
                "dangerous": false,
                "description": "Lock the current session",
                "enabled": true,
                "icon": "lock",
                "name": "Lock Screen"
            },
            {
                "command": [
                    "systemctl",
                    "suspend"
                ],
                "dangerous": false,
                "description": "Suspend system to RAM",
                "enabled": true,
                "icon": "bedtime",
                "name": "Suspend"
            },
            {
                "command": [
                    "systemctl",
                    "reboot"
                ],
                "dangerous": true,
                "description": "Reboot the system",
                "enabled": true,
                "icon": "restart_alt",
                "name": "Restart"
            },
            {
                "command": [
                    "systemctl",
                    "poweroff"
                ],
                "dangerous": true,
                "description": "Power off the computer",
                "enabled": true,
                "icon": "power_settings_new",
                "name": "Shutdown"
            }
        ],
        "favouriteApps": [
            "brave-origin",
            "ghostty",
            "org.gnome.Nautilus"
        ],
        "hiddenApps": [
            "brave-browser",
            "org\\.gnome\\.(?!Nautilus).*",
            "avahi-discover",
            "bssh",
            "bvnc",
            "lstopo",
            "nm-connection-editor",
            "qv4l2",
            "qvidcap",
            "xgps.*",
            "uuctl",
            "xfce4-about"
        ]
    },
    "lock": {
        "enabled": true
    },
    "paths": {
        "wallpaperDir": "~/Pictures/Wallpapers"
    },
    "services": {
        "useFahrenheit": false,
        "useFahrenheitPerformance": false,
        "useTwelveHourClock": false
    },
    "sidebar": {
        "dragThreshold": 80,
        "enabled": true
    },
    "utilities": {
        "quickToggles": [
            {
                "id": "wifi"
            },
            {
                "id": "ethernet"
            },
            {
                "id": "bluetooth"
            },
            {
                "id": "display"
            },
            {
                "id": "nightlight"
            },
            {
                "id": "gameMode"
            },
            {
                "id": "settings"
            }
        ],
        "toasts": {
            "capsLockChanged": false,
            "kbLayoutChanged": false
        }
    }
}
