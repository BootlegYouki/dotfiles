#!/usr/bin/env bash
# Auto-reloads Caelestia Shell safely when QML or UI components are modified

export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-1}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

if [ -z "$HYPRLAND_INSTANCE_SIGNATURE" ]; then
    export HYPRLAND_INSTANCE_SIGNATURE=$(ls -t "$XDG_RUNTIME_DIR/hypr" 2>/dev/null | head -n1)
fi

WATCH_DIR="$HOME/.config/quickshell/caelestia"

if [ ! -d "$WATCH_DIR" ]; then
    echo "Directory $WATCH_DIR not found." >&2
    exit 1
fi

echo "Watching $WATCH_DIR for QML/JS changes..."

LAST_RESTART=0

inotifywait -m -r -e close_write,moved_to,delete,create "$WATCH_DIR" --format "%w%f" --exclude '(\.git|\.swp|\.bak|\.tmp|\.json|~)' 2>/dev/null | while read -r file; do
    # Only trigger on actual source code changes
    if [[ "$file" =~ \.(qml|js|conf|lua|css|scss)$ ]]; then
        # Debounce rapid file writes
        while read -r -t 0.4 discard; do :; done
        
        NOW=$(date +%s)
        # Enforce minimum 2-second cooldown between restarts to prevent any loop
        if (( NOW - LAST_RESTART >= 2 )); then
            LAST_RESTART=$NOW
            echo "[$(date '+%H:%M:%S')] Change in $file -> Reloading Caelestia..."
            qs -c caelestia kill >/dev/null 2>&1 || true
            # Wait until previous quickshell instance completely exits to prevent layer-shell race conditions
            for i in {1..30}; do
                if ! pgrep -f "quickshell.*caelestia" >/dev/null 2>&1; then
                    break
                fi
                sleep 0.05
            done
            sleep 0.15

            # Refresh live Hyprland instance signature dynamically
            if command -v hyprctl >/dev/null 2>&1; then
                CURRENT_SIG=$(hyprctl instances -j 2>/dev/null | jq -r '.[0].instance' 2>/dev/null)
                if [ -n "$CURRENT_SIG" ] && [ "$CURRENT_SIG" != "null" ]; then
                    export HYPRLAND_INSTANCE_SIGNATURE="$CURRENT_SIG"
                fi
            fi

            caelestia shell -d >/dev/null 2>&1 || true
        fi
    fi
done
