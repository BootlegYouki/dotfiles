#!/usr/bin/env python3
import urllib.request
import re
import json
import time
import sys
import concurrent.futures

def get_fast_token():
    req = urllib.request.Request("https://fast.com", headers={"User-Agent": "Mozilla/5.0"})
    with urllib.request.urlopen(req, timeout=5) as r:
        html = r.read().decode('utf-8')
    
    js_match = re.search(r'src="(/app-[^"]+\.js)"', html)
    if not js_match:
        raise Exception("JS not found")
    
    js_url = "https://fast.com" + js_match.group(1)
    req_js = urllib.request.Request(js_url, headers={"User-Agent": "Mozilla/5.0"})
    with urllib.request.urlopen(req_js, timeout=5) as r:
        js = r.read().decode('utf-8')
    
    token_match = re.search(r'token:"([A-Za-z0-9_-]+)"', js)
    if not token_match:
        raise Exception("Token not found")
    return token_match.group(1)

def main():
    try:
        print(json.dumps({"status": "connecting", "speed": 0.0}), flush=True)
        token = get_fast_token()
        api_url = f"https://api.fast.com/netflix/speedtest/v2?https=true&token={token}&urlCount=8"
        req_api = urllib.request.Request(api_url, headers={"User-Agent": "Mozilla/5.0"})
        with urllib.request.urlopen(req_api, timeout=5) as r:
            data = json.loads(r.read().decode('utf-8'))
        
        targets = [t['url'] for t in data['targets']]
        if not targets:
            raise Exception("No targets found")

        total_bytes = 0
        start_time = time.time()
        test_duration = 5.0
        running = True

        def download_worker(idx):
            nonlocal total_bytes
            url = targets[idx % len(targets)]
            while running and (time.time() - start_time < test_duration):
                try:
                    req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
                    with urllib.request.urlopen(req, timeout=5) as resp:
                        while running and (time.time() - start_time < test_duration):
                            chunk = resp.read(131072)
                            if not chunk:
                                break
                            total_bytes += len(chunk)
                except Exception:
                    pass

        num_threads = min(len(targets), 6)
        with concurrent.futures.ThreadPoolExecutor(max_workers=num_threads) as executor:
            futures = [executor.submit(download_worker, i) for i in range(num_threads)]

            # Live sampling every 300ms
            while time.time() - start_time < test_duration:
                time.sleep(0.3)
                elapsed = time.time() - start_time
                if elapsed > 0.4:
                    cur_mbps = (total_bytes * 8) / (elapsed * 1000 * 1000)
                    print(json.dumps({"status": "testing", "speed": round(cur_mbps, 1)}), flush=True)

            running = False
            concurrent.futures.wait(futures, timeout=1.0)

        final_elapsed = time.time() - start_time
        final_mbps = (total_bytes * 8) / (final_elapsed * 1000 * 1000)
        print(json.dumps({"status": "done", "speed": round(final_mbps, 1), "unit": "Mbps"}), flush=True)

    except Exception as e:
        print(json.dumps({"status": "error", "error": str(e)}), flush=True)

if __name__ == "__main__":
    main()
